// Type Declarations

type Color = enum {
    red
    green
    blue
}

type primitive_struct = struct {
    name: str
    age: int
}

type complex_struct = struct {
    name: str
    tags: []str
    values: []int
}

type inner_struct = struct {
    name: str
    values: []int
}

type nested_struct = struct {
    id: int
    items: inner_struct
}

// Primitives

fn get_str(): str {
    return "Hello, World!"
}

fn get_int(): int {
    return 42
}

fn get_real(): real {
    return 3.14
}

fn get_bool(): bool {
    return true
}

fn get_char(): char {
    return 'a'
}

fn get_uint(): uint {
    return uint(42)
}

fn get_real32(): real32 {
    return real32(3.14)
}

fn get_enum(): Color {
    return Color.green
}

// Array & Vector Return

fn get_fixed_arr(): [5]int {
    return [5]int{10, 20, 30, 40, 50}
}

fn get_int_arr(): []int {
    return []int{1, 2, 3, 4, 5}
}

fn get_str_arr(): []str {
    return []str{"Hello", "World", "Umka"}
}

// Struct Return

fn get_primitive_struct(): primitive_struct {
    return primitive_struct{"Umka", 42}
}

fn get_complex_struct(): complex_struct {
    return complex_struct{
        "Umka",
        []str{"foo", "bar", "baz"},
        []int{1, 2, 3, 4, 5}
    }
}

fn get_struct_arr(): []inner_struct {
    return []inner_struct{
        inner_struct{"foo", []int{1, 2, 3}},
        inner_struct{"bar", []int{4, 5, 6}}
    }
}

fn get_nested_struct(): nested_struct {
    return nested_struct{
        42,
        inner_struct{
            "foo",
            []int{1, 2, 3}
        }
    }
}

fn get_nested_struct_arr(): []nested_struct {
    return []nested_struct{
        nested_struct{
            42,
            inner_struct{
                "foo",
                []int{1, 2, 3}
            }
        },
        nested_struct{
            43,
            inner_struct{
                "bar",
                []int{4, 5, 6}
            }
        }
    }
}

// Pointer Return

fn get_int_ptr(): ^int {
    p := new(int)
    p^ = 100
    return p
}

fn get_struct_ptr(): ^primitive_struct {
    p := new(primitive_struct)
    p^ = primitive_struct{"Heap", 10}
    return p
}
