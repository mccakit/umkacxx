// Type Declarations

type Color = enum {
    red
    green
    blue
}

type primitive_struct = struct {
    name: str
    age: int
}

type complex_struct = struct {
    name: str
    tags: []str
    values: []int
}

type inner_struct = struct {
    name: str
    values: []int
}

type nested_struct = struct {
    id: int
    items: inner_struct
}

// Primitives

fn get_str(): str {
    return "Hello, World!"
}

fn get_int(): int {
    return 42
}

fn get_real(): real {
    return 3.14
}

fn get_bool(): bool {
    return true
}

fn get_char(): char {
    return 'a'
}

fn get_uint(): uint {
    return uint(42)
}

fn get_real32(): real32 {
    return real32(3.14)
}

fn get_enum(): Color {
    return Color.green
}

// Array & Vector Return

fn get_fixed_arr(): [5]int {
    return [5]int{10, 20, 30, 40, 50}
}

fn get_int_arr(): []int {
    return []int{1, 2, 3, 4, 5}
}

fn get_str_arr(): []str {
    return []str{"Hello", "World", "Umka"}
}

// Struct Return

fn get_primitive_struct(): primitive_struct {
    return primitive_struct{"Umka", 42}
}

fn get_complex_struct(): complex_struct {
    return complex_struct{
        "Umka",
        []str{"foo", "bar", "baz"},
        []int{1, 2, 3, 4, 5}
    }
}

fn get_struct_arr(): []inner_struct {
    return []inner_struct{
        inner_struct{"foo", []int{1, 2, 3}},
        inner_struct{"bar", []int{4, 5, 6}}
    }
}

fn get_nested_struct(): nested_struct {
    return nested_struct{
        42,
        inner_struct{
            "foo",
            []int{1, 2, 3}
        }
    }
}

fn get_nested_struct_arr(): []nested_struct {
    return []nested_struct{
        nested_struct{
            42,
            inner_struct{
                "foo",
                []int{1, 2, 3}
            }
        },
        nested_struct{
            43,
            inner_struct{
                "bar",
                []int{4, 5, 6}
            }
        }
    }
}

// Pointer Return

fn get_int_ptr(): ^int {
    p := new(int)
    p^ = 100
    return p
}

fn get_struct_ptr(): ^primitive_struct {
    p := new(primitive_struct)
    p^ = primitive_struct{"Heap", 10}
    return p
}

// Scalar Parameters

fn add(a, b: int): int {
    return a + b
}

fn div_real(a, b: real): real {
    return a / b
}

fn scale32(x, k: real32): real32 {
    return x * k
}

fn negate(b: bool): bool {
    return !b
}

fn next_char(c: char, by: int): char {
    return char(int(c) + by)
}

fn add_uint(a, b: uint): uint {
    return a + b
}

fn color_name(c: Color): str {
    switch c {
        case Color.red:   return "red"
        case Color.green: return "green"
        case Color.blue:  return "blue"
    }
    return "unknown"
}

fn format_all(name: str, age: int, score: real, active: bool): str {
    status := active ? "on" : "off"
    return sprintf("%s|%d|%.2f|%s", name, age, score, status)
}

// String Parameters

fn greet(name: str): str {
    return "Hello, " + name + "!"
}

// Fails on anything that is not a real Umka string: the length is read from
// the string's header, not by scanning for a null character.
fn str_len(s: str): int {
    return len(s)
}

// Array Parameters

fn sum_int_arr(values: []int): int {
    sum := 0
    for i in values {
        sum += values[i]
    }
    return sum
}

fn join_strs(parts: []str, sep: str): str {
    out := ""
    for i in parts {
        if i > 0 {
            out += sep
        }
        out += parts[i]
    }
    return out
}

fn sum_fixed_arr(values: [5]int): int {
    sum := 0
    for i in values {
        sum += values[i]
    }
    return sum
}

// Struct Parameters

fn describe(p: primitive_struct): str {
    return sprintf("%s is %d", p.name, p.age)
}

fn age_by(p: primitive_struct, years: int): primitive_struct {
    return primitive_struct{p.name, p.age + years}
}

fn count_tags(s: complex_struct): int {
    return len(s.tags)
}

// Pointer Parameters

fn inc_int_ptr(p: ^int, by: int) {
    p^ += by
}

fn ptr_age(p: ^primitive_struct): int {
    return p^.age
}

// Multiple Return Values

fn make_pair(a, b: int): (int, int) {
    return a, b
}

// Void Calls

var total: int

fn accumulate(x: int) {
    total += x
}

fn get_total(): int {
    return total
}
